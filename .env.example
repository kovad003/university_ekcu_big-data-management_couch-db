# template only; run.py writes .env from it with random passwords
# .env is git-ignored

# instance A: 127.0.0.1:5984 from the host, couch-a:5984 inside docker
COUCH_A_USER=admin_a
COUCH_A_PASSWORD=change-me-a
COUCH_A_PORT=5984

# instance B: 127.0.0.1:5985 from the host, couch-b:5984 inside docker
COUCH_B_USER=admin_b
COUCH_B_PASSWORD=change-me-b
COUCH_B_PORT=5985

# replication jobs run inside the containers, where localhost is the container
# itself, so they need the service names
COUCH_A_INTERNAL_URL=http://couch-a:5984
COUCH_B_INTERNAL_URL=http://couch-b:5984
